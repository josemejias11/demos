{
  "name": "qa-workshop-auto",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "version": "1.1.0",
  "description": "Universal E2E Test Automation Framework with Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
  "ci": "npm run -s typecheck && npm run -s lint && npm run -s test:unit",
  "automation:run": "tsx automation/core/bootstrapDI.ts",
  "automation:mcp": "tsx automation/mcp/qa-automation-server.ts",
  "automation:server": "tsx automation/mcp/qa-automation-server.ts",
  "automation:selectors:audit": "tsx automation/tools/selectorInventory.ts --out tests/artifacts/selectors-inventory.csv",
  "automation:kb:suggest": "tsx automation/tools/kbSuggest.ts",
  "automation:telemetry:merge": "tsx automation/tools/mergeTelemetry.ts test-results/telemetry.parts/*.jsonl > test-results/telemetry.jsonl",
  "automation:tcms:sync": "tsx automation/integrations/kiwiSync.ts",
  "automation:discover": "tsx -e \"(async()=>{try{const {createConfiguredOrchestrator}=await import('./automation/core/bootstrapDI.ts');const {AgentController}=await import('./automation/core/agentController.ts');const orchestrator=createConfiguredOrchestrator();await orchestrator.init();const info=await AgentController.discover(orchestrator);console.log(JSON.stringify(info,null,2));await orchestrator.dispose();process.exit(0);}catch(e){console.error(e);process.exit(1);}})()\"",
  "automation:pack": "tsx -e \"(async()=>{try{const id=process.argv[3]||process.env.PACK; if(!id){console.error('Usage: npm run automation:pack -- <pack-id>  (or PACK=<id>)');process.exit(1)}; const {createConfiguredOrchestrator}=await import('./automation/core/bootstrapDI.ts'); const {AgentController}=await import('./automation/core/agentController.ts'); const orchestrator=createConfiguredOrchestrator(); await orchestrator.init(); await AgentController.runPack(orchestrator,id); await orchestrator.dispose(); console.log('Pack '+id+' executed'); process.exit(0);}catch(e){console.error(e);process.exit(1);}})()\"",
  "automation:home": "tsx -e \"(async()=>{try{const {createConfiguredOrchestrator}=await import('./automation/core/bootstrapDI.ts'); const { buildHomeBasicFlow } = await import('./automation/domain/flows/homeSmoke.ts'); const orch = createConfiguredOrchestrator(); await orch.init(); await orch.runFlow(buildHomeBasicFlow()); await orch.dispose(); console.log('home-basic-smoke completed'); process.exit(0);}catch(e){console.error(e);process.exit(1);}})()\"",
  "automation:kb:export": "tsx -e \"(async()=>{try{const {globalPatternStore}=await import('./automation/knowledge/patternStore.ts');await globalPatternStore.save();await globalPatternStore.export('test-results/kb-export.json');console.log('KB exported to test-results/kb-export.json');process.exit(0);}catch(e){console.error(e);process.exit(1);}})()\"",
  "automation:kb:stats": "tsx -e \"(async()=>{try{const {globalPatternStore}=await import('./automation/knowledge/patternStore.ts');const s=await globalPatternStore.getStatistics();console.log(JSON.stringify(s,null,2));process.exit(0);}catch(e){console.error(e);process.exit(1);}})()\"",
  "automation:branch:site": "tsx -e \"(async()=>{try{const {BranchGenerator}=await import('./automation/core/branchGenerator.ts');const res=await BranchGenerator.generateBranch({targetURL:'https://www.site.com',includeTests:true,includePageObjects:true});console.log(res.message);console.log(res.filesCreated.join('\\n'));process.exit(0);}catch(e){console.error(e);process.exit(1);}})()\"",
  "automation:kb:view": "npm run -s artifacts:merge:kb >/dev/null 2>&1; ([ -f automation-locators-kb.jsonl ] && grep -v '^$' automation-locators-kb.jsonl || echo 'KB empty')",
  "telemetry:view": "npm run -s artifacts:merge:telemetry >/dev/null 2>&1; ([ -f automation-telemetry.jsonl ] && tail -n 50 automation-telemetry.jsonl || echo 'Telemetry empty')",
  "automation:kb:import": "tsx automation/locators/kb/importer.ts",
  "selectors:inventory": "tsx automation/tools/selectorInventory.ts",
  "telemetry:tail": "tail -f automation-telemetry.jsonl || echo 'No telemetry file yet'",
  "artifacts:merge": "tsx scripts/merge-jsonl-parts.ts automation-telemetry.jsonl automation-locators-kb.jsonl",
  "artifacts:merge:telemetry": "tsx scripts/merge-jsonl-parts.ts automation-telemetry.jsonl",
  "artifacts:merge:kb": "tsx scripts/merge-jsonl-parts.ts automation-locators-kb.jsonl",
  "lint": "eslint . --ext .ts,.js",
  "lint:fix": "eslint . --ext .ts,.js --fix",
  "typecheck": "tsc -p tsconfig.json --noEmit",
  "automation:check": "npm run typecheck && npm run lint",
  "automation:health": "tsx automation/utils/healthCheck.ts",
  "test:unit": "vitest run",
  "test:unit:watch": "vitest",
  "clean-cache": "./scripts/clean-cache.sh",
  "update-browsers": "./scripts/update-browsers.sh",
  "check-deps": "./scripts/check-deps.sh",
  "format": "prettier --write .",
  "format:check": "prettier --check .",
  "coverage": "c8 playwright test",
  "test:pw": "playwright test",
  "clean-reports": "tsx automation/utils/cleanArtifacts.ts --yes",
  "open-report": "./scripts/open-report.sh",
  "trace:latest": "tsx automation/utils/showLatestTrace.ts",
  "test:ci": "HEADLESS=true npx playwright test --grep '@ci'",
  "probe": "tsx scripts/dom-probe.ts",
  "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
  "allure:open": "allure open ./allure-report",
  "report:allure": "npm run -s allure:generate && npm run -s allure:open",
  "kiwi:start": "cd docker/kiwi-tcms && docker compose up -d",
  "kiwi:stop": "cd docker/kiwi-tcms && docker compose down",
  "kiwi:logs": "cd docker/kiwi-tcms && docker compose logs -f",
  "kiwi:test": "tsx automation/integrations/testKiwiConnection.ts",
  "kiwi:status": "tsx automation/integrations/kiwiSync.ts status",
  "kiwi:sync-cases": "tsx automation/integrations/kiwiSync.ts sync-cases",
  "kiwi:sync-results": "tsx automation/integrations/kiwiSync.ts sync-results",
  "test:kiwi": "npx playwright test && tsx automation/integrations/kiwiSync.ts",
  "mcp:start": "mkdir -p logs && (BASE_URL=\"$BASE_URL\" nohup npm run -s automation:mcp > logs/mcp.out 2>&1 & echo $! > .mcp.pid && echo MCP started PID $(cat .mcp.pid))",
  "mcp:status": "[ -f .mcp.pid ] && ps -p \"$(cat .mcp.pid)\" || echo 'MCP not running'",
  "mcp:stop": "[ -f .mcp.pid ] && kill \"$(cat .mcp.pid)\" && rm .mcp.pid || echo 'No .mcp.pid file'",
  "mcp:logs": "tail -n 50 -f logs/mcp.out"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.3",
    "@babel/traverse": "^7.28.3",
    "@faker-js/faker": "^8.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.204.0",
    "@playwright/test": "^1.55.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "allure-commandline": "^2.13.9",
    "allure-playwright": "^2.15.1",
    "c8": "^8.0.1",
    "dotenv": "^16.3.1",
    "eslint": "^9.34.0",
    "fast-glob": "^3.3.3",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "axios": "^1.11.0"
  }
}
