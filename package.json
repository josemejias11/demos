{
  "name": "demos",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:moodys-com": "playwright test --config=playwright.config.ts; open test-results/html/index.html",
    "test:moodys-com:headed": "playwright test --config=playwright.config.ts --headed",
    "test:moodys-com:showcase": "playwright test e2e/interactive-showcase.spec.ts --headed",
    "dev:moodys-com": "playwright test --config=playwright.config.ts --headed --debug",
    "automation:run:moodys-com": "tsx src/core/bootstrapDI.ts",
    "automation:kb:view:moodys-com": "grep \"https://www.moodys.com/\" discovery-results/automation-locators-kb.jsonl || echo 'No entries for moodys.com'"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
