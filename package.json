{
  "name": "planatechnologies-tests",
  "version": "1.0.0",
  "description": "Playwright test suite for planatechnologies.com",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:planatechnologies-com": "playwright test --config=playwright.config.ts",
    "test:headed": "playwright test --config=playwright.config.ts --headed",
    "test:debug": "playwright test --config=playwright.config.ts --headed --debug",
    "test:ui": "playwright test --ui",
    "automation:run:planatechnologies-com": "tsx automation/core/bootstrapDI.ts --site=planatechnologies-com",
    "automation:kb:view:planatechnologies-com": "grep \"https://planatechnologies.com\" discovery-results/automation-locators-kb.jsonl || echo 'No entries for planatechnologies.com'",
    "report": "playwright show-report test-results/html",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.8.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
