{
  "name": "demos",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:demo": "playwright test --config=playwright.config.ts; open test-results/html/index.html",
    "test:demo:headed": "playwright test --config=playwright.config.ts --headed",
    "test:demo:showcase": "playwright test e2e/interactive-showcase.spec.ts --headed",
    "test:demo:api": "playwright test api/api.spec.ts",
    "dev:demo": "playwright test --config=playwright.config.ts --headed --debug",
    "automation:run:demo": "tsx src/core/bootstrapDI.ts",
    "automation:kb:view:demo": "grep \"https://example.com/\" discovery-results/automation-locators-kb.jsonl || echo 'No entries for demo'",
    "clean": "rm -rf test-results discovery-results playwright-tmp playwright-report blob-report",
    "dashboard": "node dashboard/server.js",
    "portal:backend": "cd observability-portal/backend && npm run start:dev",
    "portal:frontend": "cd observability-portal/frontend && npm run dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
